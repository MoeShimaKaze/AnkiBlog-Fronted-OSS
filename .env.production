# 生产环境配置
NODE_ENV=production

# API 地址：默认走相对路径，由反向代理（Nginx / Caddy）转发到后端
# 若前后端分离部署且未配置代理，请改为完整地址，例如 https://api.example.com/api
VITE_API_BASE_URL=/api

# 生产环境启用 Service Worker
VITE_ENABLE_SW=true

# 功能开关
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEVTOOLS=false

# 调试开关
VITE_DEBUG_SW=false
VITE_DEBUG_API=false
