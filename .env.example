# 环境变量样例
# 复制为 .env.development（开发）或 .env.production（生产）后修改

# ===== 后端 API =====
# 开发环境示例：http://localhost:8080/api
# 生产环境推荐使用相对路径 /api，由反向代理转发
VITE_API_BASE_URL=http://localhost:8080/api

# ===== Service Worker =====
VITE_ENABLE_SW=false

# ===== 功能开关 =====
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEVTOOLS=true

# ===== 调试开关 =====
VITE_DEBUG_SW=false
VITE_DEBUG_API=false
